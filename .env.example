# ==========================================
# Application Configuration (.env.example)
# Never commit real secrets or credentials!
# ==========================================

# Database connection URL
# Local SQLite: file:./dev.db
# Cloud PostgreSQL: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL="file:./dev.db"

# Server Port (Cloud Run dynamically injects $PORT, defaults to 5001 locally)
PORT=5001

# JWT Secret for signing borrower and custodian tokens
JWT_SECRET="example-jwt-secret-replace-in-env"

# Environment Mode: development | production | test
NODE_ENV=development

# Optional Seed Config for Production deployments
# ADMIN_PASSWORD=change-me
# SEED_DEMO_DATA=false
