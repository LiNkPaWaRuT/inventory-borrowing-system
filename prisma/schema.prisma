datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   // "BORROWER" | "CUSTODIAN"
  createdAt    DateTime @default(now())

  loans        Loan[]
}

model Item {
  id           String   @id @default(uuid())
  title        String
  serialNumber String   @unique
  category     String
  isAvailable  Boolean  @default(true)
  status       String   @default("AVAILABLE") // "AVAILABLE" | "PENDING_APPROVAL" | "CHECKED_OUT" | "MAINTENANCE"
  createdAt    DateTime @default(now())

  loans        Loan[]
}

model Loan {
  id             String    @id @default(uuid())
  itemId         String
  borrowerId     String
  status         String    @default("REQUESTED") // "REQUESTED" | "ACTIVE" | "RETURNED" | "OVERDUE"
  conditionGrade String?   // "GOOD" | "FAIR" | "DAMAGED"
  returnNotes    String?
  penaltyFine    Float?    @default(0.0)
  dueAt          DateTime?
  requestedAt    DateTime  @default(now())
  checkedOutAt   DateTime?
  returnedAt     DateTime?

  item           Item      @relation(fields: [itemId], references: [id])
  borrower       User      @relation(fields: [borrowerId], references: [id])
}
